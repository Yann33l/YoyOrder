#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Peut être appelé par un lien /usr/local/bin/maj-yoyorder depuis tout dossier.
ROOT="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
cd "$ROOT"
MODE="${1:-update}"
case "$MODE" in
  update|--no-pull|--backup-only) ;;
  -h|--help)
    printf 'Usage: maj-yoyorder [--no-pull | --backup-only]\n'
    exit 0 ;;
  *) printf 'Argument inconnu : %s\n' "$MODE" >&2; exit 2 ;;
esac

fail() { printf 'ERREUR : %s\n' "$*" >&2; exit 1; }
for tool in docker flock node readlink; do
  command -v "$tool" >/dev/null || fail "Commande manquante : $tool"
done
exec 9>"$ROOT/.maj-yoyorder.lock"
flock -n 9 || fail 'Une mise à jour ou sauvegarde est déjà en cours.'
[[ -f .env.production && -f .env.production.server ]] || fail 'Créer .env.production et .env.production.server depuis les exemples.'
COMPOSE=(docker compose --project-name yoyorder --env-file "$ROOT/.env.production" -f "$ROOT/docker-compose.yml")
"${COMPOSE[@]}" version >/dev/null
docker info >/dev/null

backup() {
  mkdir -p "$ROOT/backups"
  BACKUP="$ROOT/backups/yoyorder-$(date -u +%Y%m%dT%H%M%SZ)-$$.dump"
  printf 'Sauvegarde PostgreSQL : %s\n' "$BACKUP"
  "${COMPOSE[@]}" exec -T postgres sh -c 'exec pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' > "$BACKUP.partial"
  [[ -s "$BACKUP.partial" ]] || fail 'Sauvegarde vide ; mise à jour interrompue.'
  "${COMPOSE[@]}" exec -T postgres pg_restore --list < "$BACKUP.partial" >/dev/null
  mv "$BACKUP.partial" "$BACKUP"
}

if [[ "$MODE" == --backup-only ]]; then
  "${COMPOSE[@]}" config --quiet
  backup
  exit 0
fi
for tool in git wasp npm; do
  command -v "$tool" >/dev/null || fail "Commande manquante : $tool"
done
if [[ "$MODE" == update ]]; then
  [[ -z "$(git status --porcelain)" ]] || fail 'Le dépôt contient des modifications locales ; les conserver ou utiliser --no-pull.'
  git pull --ff-only
fi
# Vérifier la configuration après le pull, sans afficher les secrets.
"${COMPOSE[@]}" config --quiet
[[ -d app/migrations ]] && find app/migrations -name migration.sql -print -quit | grep -q . \
  || fail 'Migrations absentes : générer et versionner wasp db migrate-dev en développement avant le déploiement.'

WASP_SERVER_URL="$("${COMPOSE[@]}" config --format json | node -e 'let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>process.stdout.write(JSON.parse(s).services.server.environment.WASP_SERVER_URL));')"
printf 'Compilation Wasp et interface...\n'
(
  cd app
  wasp version | grep -Eq '0\.25\.' || fail 'Installer Wasp 0.25.x, comme déclaré dans main.wasp.ts.'
  wasp install
  wasp build
  REACT_APP_API_URL="$WASP_SERVER_URL" npx --no-install vite build
)
[[ -f app/.wasp/out/Dockerfile && -f app/.wasp/out/web-app/build/200.html ]] || fail 'Artefacts Wasp manquants.'
# Construire avant de toucher aux conteneurs en cours.
"${COMPOSE[@]}" build server web
"${COMPOSE[@]}" up -d --wait --wait-timeout 120 postgres
backup
printf 'Démarrage (les migrations sont appliquées par le serveur Wasp)...\n'
if ! "${COMPOSE[@]}" up -d --wait --wait-timeout 240 server web; then
  printf 'Le déploiement a échoué. Consulter docker compose logs server web.\nSauvegarde : %s\n' "$BACKUP" >&2
  exit 1
fi
printf 'YoyOrder mis à jour. Sauvegarde : %s\n' "$BACKUP"
"${COMPOSE[@]}" ps
