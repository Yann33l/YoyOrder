# Copier en .env.production. Ne pas utiliser le .env de l'ancienne application.
POSTGRES_DB=yoyorder
POSTGRES_USER=yoyorder
# openssl rand -hex 32 : utiliser de l'hexadécimal (compatible URL PostgreSQL).
POSTGRES_PASSWORD=
# Autre valeur indépendante : openssl rand -hex 32
JWT_SECRET=
WASP_WEB_CLIENT_URL=https://order.example.fr
WASP_SERVER_URL=https://api-order.example.fr
YOYORDER_WEB_PORT=3100
YOYORDER_API_PORT=3101
